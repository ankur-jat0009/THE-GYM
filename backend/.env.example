# Database Configuration (Supabase PostgreSQL in production, SQLite in local dev)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./thegym.db

# JWT & Authentication
JWT_SECRET_KEY=change-this-to-a-super-secret-random-hex-string-for-production-thegym-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Frontend URL for CORS
FRONTEND_URL=https://thegym-gurugram.vercel.app
